APP_NAME=OSINT AI Framework
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
TLS_PORT=8443
# Hostname or LAN IP included in the local TLS certificate when sharing.
SHARE_HOST=localhost

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=osint_db
POSTGRES_USER=osint
POSTGRES_PASSWORD=replace-with-a-strong-database-password

SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=OSINT AI Framework

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_FAIL_CLOSED=true
METRICS_TOKEN=
DEFAULT_RETENTION_DAYS=365
REQUIRE_LEGAL_METADATA=false

OSINT_HTTP_TIMEOUT_SECONDS=15
OSINT_MAX_RESPONSE_BYTES=2000000
OSINT_MAX_ITEMS_PER_COLLECTOR=200
OSINT_USER_AGENT=OSINT-AI-Framework/0.2 (+local-authorized-research)
OSINT_SEARCH_LANGUAGE=es

# Isolated low-impact validation service. The worker reaches it only through
# the dedicated Docker network; it is not published on the host.
SOC_SANDBOX_ENABLED=true
SOC_SANDBOX_URL=http://sandbox:8090
SOC_SANDBOX_TIMEOUT_SECONDS=20

ORCHESTRATOR_MAX_TOOLS=40
ORCHESTRATOR_REQUIRE_OLLAMA=false

# Optional premium/public-quota integrations. Leave blank to keep disabled.
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
URLSCAN_API_KEY=

LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_CHUNK_CHARACTERS=1600
RAG_CHUNK_OVERLAP_CHARACTERS=240
RAG_MAX_DOCUMENT_CHARACTERS=500000
RAG_MAX_CHUNKS_PER_PROJECT=10000
RAG_EMBEDDING_BATCH_SIZE=32
LLM_TIMEOUT_SECONDS=120
LLM_MAX_EVIDENCE_CHARACTERS=50000

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","api","testserver"]
SMOKE_BASE_URL=http://localhost:8000

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
